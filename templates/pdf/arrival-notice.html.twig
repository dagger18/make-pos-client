<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if basePath is defined %}
<base href="{{ basePath }}" />
{% endif %}
<link rel="stylesheet" href="{{ api_path_prefix }}/build/css/pdf.css">
<style>
body { font-size: 0.9em; }
.header-section { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 16px; }
.section-title { font-weight: bold; text-transform: uppercase; font-size: 1.1em; margin: 12px 0 6px; border-bottom: 1px solid #ccc; }
.info-row { display: flex; margin-bottom: 4px; }
.info-label { font-weight: bold; min-width: 200px; }
.notice-box { border: 1px solid #000; padding: 10px; margin: 10px 0; }
</style>
</head>
<body>
<table class="table is-fullwidth no-border-td">
<tr>
  <td width="100px" style="vertical-align: middle;">
    <img width="80" src="{{ company.logo.path | imagine_filter('pdf_logo') }}" />
  </td>
  <td style="vertical-align: middle;">
    <div style="font-size: 1.4em; font-weight: bold;">{% trans %}ARRIVAL NOTICE{% endtrans %}</div>
    <div>{{ company.name }}</div>
    <div style="font-size: 0.85em; color: #555;">{{ company.address }}</div>
  </td>
  <td width="220px" style="vertical-align: top; text-align: right; font-size: 0.85em;">
    <div><b>{% trans %}Date{% endtrans %}:</b> {{ arrivalNotice.issueDate ? arrivalNotice.issueDate | date('d/m/Y') : '—' }}</div>
    <div><b>{% trans %}Shipment{% endtrans %}:</b> {{ shipment.code }}</div>
  </td>
</tr>
</table>

<table class="table is-fullwidth center-border-td" style="margin-top: 12px;">
  <tr>
    <td colspan="2">
      <b>{% trans %}TO{% endtrans %}:</b><br>
      <div class="font-courier pl-2 pt-1">
        <b>{{ arrivalNotice.consigneeName }}</b><br>
        <div style="white-space: pre-wrap;">{{ arrivalNotice.consigneeAddress }}</div>
      </div>
    </td>
  </tr>
  <tr>
    <td width="50%">
      <b>{% trans %}Port of Loading{% endtrans %}</b><br>
      <span class="font-courier">{{ booking.portLoading ? booking.portLoading.name : '—' }}</span>
    </td>
    <td width="50%">
      <b>{% trans %}Port of Discharge{% endtrans %}</b><br>
      <span class="font-courier">{{ booking.portDischarge ? booking.portDischarge.name : '—' }}</span>
    </td>
  </tr>
  <tr>
    <td>
      <b>{% trans %}Vessel / Voyage{% endtrans %}</b><br>
      <span class="font-courier">{{ booking.vesselNo ?? '—' }}</span>
    </td>
    <td>
      <b>{% trans %}ETD{% endtrans %}</b><br>
      <span class="font-courier">{{ booking.etd ? booking.etd | date('d/m/Y') : '—' }}</span>
    </td>
  </tr>
  <tr>
    <td>
      <b>{% trans %}House B/L No.{% endtrans %}</b><br>
      <span class="font-courier">{{ shipment.houseBill ?? '—' }}</span>
    </td>
    <td>
      <b>{% trans %}Master B/L No.{% endtrans %}</b><br>
      <span class="font-courier">{{ shipment.masterBill ?? '—' }}</span>
    </td>
  </tr>
</table>

{% if arrivalNotice.destinationChargesNote %}
<div class="section-title">{% trans %}Destination Charges{% endtrans %}</div>
<div style="white-space: pre-wrap; padding: 6px;">{{ arrivalNotice.destinationChargesNote }}</div>
{% endif %}

{% if arrivalNotice.requiredDocuments and arrivalNotice.requiredDocuments|length > 0 %}
<div class="section-title">{% trans %}Required Documents{% endtrans %}</div>
<ul>
{% for doc in arrivalNotice.requiredDocuments %}
  <li>{{ doc }}</li>
{% endfor %}
</ul>
{% endif %}

{% if arrivalNotice.note %}
<div class="section-title">{% trans %}Note{% endtrans %}</div>
<div style="white-space: pre-wrap; padding: 6px;">{{ arrivalNotice.note }}</div>
{% endif %}

<div style="margin-top: 40px; font-size: 0.8em; color: #666; text-align: center;">
  {% trans %}This is an automatically generated document.{% endtrans %}
</div>
</body>
</html>
