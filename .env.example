# make-pos-client — POS SaaS Backend
APP_ENV=dev
APP_SECRET=ChangeMe
APP_DEBUG=true
IS_MAINTENANCE=false

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

DATABASE_URL="mysql://root:@127.0.0.1:3306/make_pos?serverVersion=8.0&charset=utf8mb4"
DOCTRINE_SERVER_VERSION=8.0

MASTER_API_URL=
MASTER_API_KEY=

BREVO_API_KEY=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

PRIVATE_SMTP_HOST=
PRIVATE_SMTP_PORT=587
PRIVATE_SMTP_USER=
PRIVATE_SMTP_PASSWORD=

AWS_S3_KEY=
AWS_S3_SECRET=
AWS_S3_REGION=ap-southeast-1
AWS_S3_BUCKET=

BACKUP_MEDIA_URL=http://localhost:8001
BACKUP_MEDIA_API_KEY=changeme

MAILER_DSN=null://null
APP_BASE_URL=

SENTRY_DSN=
SENTRY_RELEASE=
